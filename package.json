{
  "name": "@jpokropinski/portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://jaroslawpokropinski.github.io",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "prerender": "tsx ./scripts/prerender.ts",
    "generate-sitemap": "tsx ./scripts/generate-sitemap.ts",
    "predeploy": "npm run build && npm run prerender && npm run generate-sitemap",
    "deploy": "tsx ./scripts/deploy.ts",
    "preview": "vite preview",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "flowbite-react": "^0.8.0",
    "react": "^18.2.0",
    "react-code-blocks": "^0.1.6",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@prerenderer/prerenderer": "^1.2.5",
    "@prerenderer/renderer-puppeteer": "^1.2.4",
    "@types/gh-pages": "^6.1.0",
    "@types/react": "^18.2.67",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.18",
    "cheerio": "^1.2.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "eslint-plugin-tailwindcss": "^3.15.1",
    "gh-pages": "^6.2.0",
    "postcss": "^8.5.25",
    "prettier-plugin-tailwindcss": "^0.5.12",
    "puppeteer": "^25.5.0",
    "sitemap": "^9.0.1",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.20.3",
    "typescript": "^5.4.2",
    "vite": "^8.1.3"
  },
  "allowScripts": {
    "esbuild@0.25.8": true,
    "puppeteer@25.5.0": true
  }
}
